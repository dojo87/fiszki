<Window x:Class="IrregularVerbTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Irregular Verb Trainer"
        Width="620" Height="700" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F3F6FB">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="IRREGULAR VERBS" Foreground="#2457A7"
                       FontSize="13" FontWeight="Bold" />
            <TextBlock Text="Practice English forms" Foreground="#172033"
                       FontSize="28" FontWeight="Bold" Margin="0,4,0,0" />
            <TextBlock Text="One field is filled in. Complete the remaining fields."
                       Foreground="#64748B" FontSize="14" Margin="0,5,0,0" />
            <DockPanel Margin="0,12,0,0">
                <Button Content="Choose CSV..."
                        Click="ChooseFileButton_Click" Background="#E2E8F0"
                        Foreground="#172033" Padding="12,7" />
                <TextBlock x:Name="SourceText" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="#64748B"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FormPanel" />
                </ScrollViewer>
                <Border x:Name="FeedbackBorder" Grid.Row="1" Background="#F1F5F9"
                        CornerRadius="8" Padding="12" Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="FeedbackText" TextWrapping="Wrap"
                               FontSize="14" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="ProgressText" DockPanel.Dock="Left"
                       VerticalAlignment="Center" Foreground="#64748B"
                       Text="Weighted practice" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CheckButton" Content="Check answer"
                        Click="CheckButton_Click" Background="#2457A7"
                        Foreground="White" IsDefault="True" />
                <Button x:Name="NextButton" Content="Next word"
                        Click="NextButton_Click" Background="#E2E8F0"
                        Foreground="#172033" Margin="10,0,0,0"
                        IsEnabled="False" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
